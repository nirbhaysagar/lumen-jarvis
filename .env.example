# ==========================================
# LUMEN HUB CONFIGURATION (.env)
# Bring Your Own Key (BYOK) Template
# ==========================================

# 1. Hub Environment
LUMEN_ENV=development
LUMEN_LOG_LEVEL=info

# 2. Database (PostgreSQL + pgvector)
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_secure_pass
POSTGRES_DB=lumen_memory
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lumen:lumen_secure_pass@localhost:5432/lumen_memory

# 3. Queue & Cache (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# 4. Standalone Memory Engine Service
MEMORY_ENGINE_PORT=8000
MEMORY_ENGINE_URL=http://localhost:8000

# 5. Model Routing & LLM Keys (LiteLLM)
# Add at least one valid key below:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# 6. Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
